includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    # Only scan core application code during real-time editor checks
    paths:
        - app/

    level: 5

    # Speeds up analysis by utilizing internal PHPStan performance enhancements
    featureToggles:
        bleedingEdge: true